{
  "name": "shibaslim",
  "version": "0.2.2",
  "description": "批量压缩 PPTX 体积的跨平台工具，重点压缩内嵌图片；提供命令行和浏览器图形界面",
  "type": "module",
  "bin": {
    "shibaslim": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "gui"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/optimize.test.mjs test/attribution.test.mjs test/gui.test.mjs test/i18n.test.mjs test/desktop.test.mjs test/render.test.mjs",
    "prepare": "npm run build",
    "gui": "npm run build && node dist/cli.js gui",
    "desktop:stage": "npm run build && node desktop/stage.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "compress",
    "image",
    "batch"
  ],
  "author": "Wonvy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wonvy/ShibaSlim.git"
  },
  "homepage": "https://github.com/Wonvy/ShibaSlim",
  "dependencies": {
    "jszip": "^3.10.2",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "pptxgenjs": "^4.0.1",
    "typescript": "^7.0.2"
  }
}
