{
  "name": "shibaslim",
  "version": "0.1.0",
  "description": "批量压缩 PPTX 文件体积的跨平台命令行工具，重点压缩内嵌图片",
  "type": "module",
  "bin": {
    "shibaslim": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/optimize.test.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "compress",
    "image",
    "batch"
  ],
  "license": "MIT",
  "dependencies": {
    "jszip": "^3.10.2",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "pptxgenjs": "^4.0.1",
    "typescript": "^7.0.2"
  }
}
