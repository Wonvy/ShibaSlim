<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Lets macOS draw its own parts of the app (file pickers, system menu items, dialogs) in Chinese
       or English to match the system, instead of always in English. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
  <key>CFBundleAllowMixedLocalizations</key>
  <true/>
  <!-- Shown when ShibaSlim first asks PowerPoint to export slides as pictures. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>ShibaSlim 会让 Microsoft PowerPoint 把幻灯片导出成图片。ShibaSlim asks Microsoft PowerPoint to export slides as pictures.</string>
</dict>
</plist>
